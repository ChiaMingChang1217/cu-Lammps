  "density": {
    "mathml": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mrow><msub><mi>ρ</mi><mi>i</mi></msub><mo>=</mo><mrow><munder><mo>∑</mo><mrow><mi>j</mi><mo>≠</mo><mi>i</mi></mrow></munder><mrow><mi>f</mi><mrow><mo>(</mo><msub><mi>r</mi><mi>ij</mi></msub><mo>)</mo></mrow></mrow></mrow></mrow></math>",
    "latex": "\\rho_i=\\sum_{j\\ne i}f(r_{ij})"
