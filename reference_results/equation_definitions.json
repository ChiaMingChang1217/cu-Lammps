{
  "eam": {
    "mathml": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><mrow><mi>U</mi><mo>=</mo><mrow><munderover><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><mrow><mi>F</mi><mrow><mo>(</mo><msub><mi>ρ</mi><mi>i</mi></msub><mo>)</mo></mrow></mrow><mo>+</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><munderover><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><munder><mo>∑</mo><mrow><mi>j</mi><mo>≠</mo><mi>i</mi></mrow></munder><mrow><mi>ψ</mi><mrow><mo>(</mo><msub><mi>r</mi><mi>ij</mi></msub><mo>)</mo></mrow></mrow></mrow></mrow></math>",
    "latex": "U=\\sum_{i=1}^{N}F(\\rho_i)+\\frac{1}{2}\\sum_{i=1}^{N}\\sum_{j\\ne i}\\psi(r_{ij})"
